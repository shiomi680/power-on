# Raspberry Pi WOL サービス設定

# PC のアドレス（IP or hostname）
PC_ADDRESS=192.168.1.100

# PC API のポート
PC_API_PORT=5001

# PC API のタイムアウト（秒）
PC_API_TIMEOUT=5

# ターゲット PC の MAC アドレス
WOL_TARGET_MAC=aa:bb:cc:dd:ee:ff

# WOL ブロードキャスト IP
WOL_BROADCAST_IP=255.255.255.255

# ロギングレベル (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
