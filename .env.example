# Power-On デプロイメント環境変数テンプレート
# このファイルを .env にコピーして、環境に応じて値を編集してください

# ========================================
# Raspberry Pi WOL サービス設定
# ========================================

# 対象 PC のネットワーク・アドレス（必須・編集必須）
# 例: 192.168.1.100
PC_ADDRESS=192.168.1.100

# 対象 PC の MAC アドレス（必須・編集必須）
# 例: aa:bb:cc:dd:ee:ff
# 確認方法: Linux/macOS: ip addr show, Windows: ipconfig /all
WOL_TARGET_MAC=aa:bb:cc:dd:ee:ff

# WOL マジックパケット送信先アドレス（デフォルト: ブロードキャスト）
# 例: 255.255.255.255（全ブロードキャスト）または 192.168.1.255（サブネット）
WOL_BROADCAST_IP=255.255.255.255

# Flask Web UI・API バインドアドレス
FLASK_HOST=0.0.0.0

# Flask Web UI・API ポート
FLASK_PORT=5000

# ログレベル（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# ========================================
# PC 電源制御 API 設定
# ========================================

# シャットダウン前の待機時間（秒）
SHUTDOWN_TIMEOUT=60

# Flask PC API ポート
# PC_API_PORT=5001
